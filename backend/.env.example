# Server
PORT=5005
NODE_ENV=development

# Database
# Use your MongoDB Atlas URI here.
MONGODB_URI=mongodb://username:password@host1:27017,host2:27017,host3:27017/database?ssl=true&replicaSet=your-replica-set&authSource=admin&retryWrites=true&w=majority

# Find Item by Image
ML_SERVICE_URL=http://127.0.0.1:8000
IMAGE_UPLOAD_MAX_MB=5

# Chat Assistant
GROQ_API_KEY=

# Account credential email notifications (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@example.com
